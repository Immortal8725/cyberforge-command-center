# CyberForge defensive core — local lab placeholders.
# Copy to .env before changing ports. Do not put real production secrets here.
# Postgres settings are reserved for a later phase; this compose file does not
# start a database.

COMPOSE_PROJECT_NAME=cyberforge

# Elasticsearch / Kibana / Filebeat share one version pin.
ELASTIC_VERSION=8.19.23
ELASTICSEARCH_PORT=9200
ES_JAVA_OPTS=-Xms512m -Xmx512m

# Kibana
KIBANA_PORT=5601
# Local saved-object key only. Replace before any non-local deployment.
KIBANA_ENCRYPTION_KEY=cyberforge-local-lab-key-32b-min

# ML anomaly engine (container listens on 8080; host port is configurable).
ML_ENGINE_PORT=8088
ML_SCORE_THRESHOLD=0.65
ML_RATE_ZSCORE_THRESHOLD=3.0

# Reserved. Unused by docker-compose.yml in this phase.
POSTGRES_USER=cyberforge
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=cyberforge
POSTGRES_PORT=5432
